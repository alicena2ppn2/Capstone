{
  "expo": {
    "name": "모찌와 친구들",
    "slug": "capstone-mochi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.alicena2ppn2.mymochi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "io.github.alicena2ppn2.mymochi",
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "미션 사진을 선택해 사진첩에 저장할 수 있도록 사진 접근을 허용해 주세요.",
          "cameraPermission": "사진 미션을 직접 촬영할 수 있도록 카메라 접근을 허용해 주세요.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "걸음 미션을 확인하려고 Apple 건강의 걸음 수를 읽어요. 걸음 수 말고는 읽지 않고, 건강 데이터에 쓰지도 않아요.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3E8F6E"
        }
      ]
    ],
    "scheme": "capstone-mochi",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "694b8d60-d14d-442e-b2ff-15c31d5450b7"
      }
    },
    "owner": "sungshin"
  }
}
