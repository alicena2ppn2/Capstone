    "test": "node --test src/storage/storage.test.mjs ../shared/features/journal.test.js ../shared/features/game.test.js ../shared/features/attendance.test.js ../shared/features/visitors.test.js src/auth/supabaseAuthCore.test.mjs ../shared/features/dailyMissions.test.js ../shared/features/missionPhotos.test.js ../shared/features/dailySentence.test.js ../shared/features/missionGuidance.test.js ../shared/features/missionReplacement.test.js ../shared/features/questCompact.test.js ../shared/auth/authBackendController.test.mjs",
