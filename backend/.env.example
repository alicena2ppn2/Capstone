# 복사해서 backend/.env 로 저장하면 서버가 시작할 때 읽는다 (.env는 Git에 올리지 않음)

# Supabase 로그인 토큰 확인 (POST /auth/supabase). 비워 두면 개발·시연 모드: 앱이 보낸 supabase_id를 그대로 믿음
# 값은 mobile/.env.local 의 EXPO_PUBLIC_SUPABASE_URL · EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY 와 같다 (공개용 키, 관리자 키 아님)
SUPABASE_URL=
SUPABASE_KEY=

# 관리자 API (위기 신호, 소감 통계). 비워 두면 관리자 API가 꺼짐
ADMIN_TOKEN=

# 웹에서 부를 때 허용할 주소 (쉼표로 여러 개). 휴대폰 앱(Expo Go·개발 빌드)은 상관없음
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# DB·사진 위치 (기본: backend/app.db, backend/uploads/)
# CAPSTONE_DB=
# CAPSTONE_UPLOADS=
